{
  "name": "dismud",
  "version": "1.0.0",
  "description": "A Discord-based MUD (Multi-User Dungeon) built with TypeScript, bitECS, and SQLite",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:web": "node dist/web/server.js",
    "start:dev": "ts-node src/main.ts",
    "start:web:dev": "ts-node src/web/server.ts",
    "dev": "ts-node --watch src/main.ts",
    "build": "tsc",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "parse-world": "ts-node src/simulation/world-data/libs/world/exportWldToJson.ts",
    "parse-obj": "ts-node src/simulation/world-data/libs/obj/exportObjsToJson.ts",
    "parse-mob": "ts-node src/simulation/world-data/libs/mob/exportMobsToJson.ts",
    "parse-zon": "ts-node src/simulation/world-data/libs/zone/exportZonToJson.ts",
    "parse-all": "npm run parse-world && npm run parse-obj && npm run parse-mob && npm run parse-zon",
    "import-world": "ts-node src/simulation/world-data/libs/world/writeWldJsonToDb.ts",
    "import-obj": "ts-node src/simulation/world-data/libs/obj/writeObjJsonToDb.ts",
    "import-mob": "ts-node src/simulation/world-data/libs/mob/writeMobJsonToDb.ts",
    "import-zone": "ts-node src/simulation/world-data/libs/zone/writeZonJsonToDb.ts",
    "import-all": "npm run import-world && npm run import-obj && npm run import-mob && npm run import-zone"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zetaphor/bit-ecs-discord.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zetaphor/bit-ecs-discord/issues"
  },
  "homepage": "https://github.com/Zetaphor/bit-ecs-discord#readme",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "bitecs": "^0.3.40",
    "discord.js": "^14.7.1",
    "dotenv": "^16.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.8.0",
    "@types/pino": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
